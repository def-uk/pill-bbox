# 이 파일을 .env로 복사해서 값을 채우세요. .env는 커밋되지 않습니다.
# API 키: https://wandb.ai/authorize
WANDB_API_KEY=
# 팀(entity) 이름. 비워 두면 개인 계정에 기록됩니다.
WANDB_ENTITY=pill-bbox
WANDB_PROJECT=pillbbox
# 데이터 zip의 Google Drive 공유 링크 ("링크가 있는 모든 사용자"로 공유)
DATA_URL=
# AI Hub API 키 (마이페이지에서 발급, 경구약제 이미지 데이터 576번 승인 필요). AI Hub는 해외 IP 다운로드를 막아 국내 PC에서만 받음
AI_HUB_API_KEY=
# AI Hub 조합 zip이 있는 폴더 (로컬에서 notebooks/02_eda.ipynb 실행용, 예: Google Drive 데스크톱 폴더)
AIHUB_ZIP_DIR=
# zip을 풀 폴더. 비워 두면 data/external/aihub_combo
AIHUB_EXTRACT_DIR=
